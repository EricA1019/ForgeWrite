{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "forgerwrite.approval_record.v1",
  "title": "Approval Record",
  "description": "Terminal-generated approval bound to a preview diff hash.",
  "type": "object",
  "required": [
    "schema_id",
    "run_id",
    "approved",
    "approved_at",
    "approval_method",
    "preview_diff_sha256"
  ],
  "properties": {
    "schema_id": {
      "type": "string",
      "const": "forgerwrite.approval_record.v1"
    },
    "run_id": {
      "type": "string",
      "description": "The run this approval is for.",
      "minLength": 1
    },
    "approved": {
      "type": "boolean",
      "description": "Whether the user approved the preview."
    },
    "approved_at": {
      "type": "string",
      "description": "ISO 8601 timestamp of approval.",
      "format": "date-time"
    },
    "approval_method": {
      "type": "string",
      "description": "How approval was given (e.g., 'terminal_cli').",
      "minLength": 1
    },
    "preview_diff_sha256": {
      "type": "string",
      "description": "SHA-256 hash of preview.diff at approval time.",
      "pattern": "^[a-f0-9]{64}$"
    },
    "worktree_clean_at_approval": {
      "type": "boolean",
      "description": "Whether the worktree was clean when approved."
    }
  },
  "additionalProperties": false
}
