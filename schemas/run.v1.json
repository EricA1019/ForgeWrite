{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "forgerwrite.run.v1",
  "title": "Run Metadata",
  "description": "Metadata wrapper for a single ForgerWrite run.",
  "type": "object",
  "required": ["schema_id", "run_id", "slice_id", "status", "created_at"],
  "properties": {
    "schema_id": {
      "type": "string",
      "const": "forgerwrite.run.v1"
    },
    "run_id": {
      "type": "string",
      "description": "Unique run identifier.",
      "minLength": 1
    },
    "slice_id": {
      "type": "string",
      "description": "The slice this run executed.",
      "minLength": 1
    },
    "model_name": {
      "type": "string",
      "description": "Name of the local model used."
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "contracts_validated",
        "context_ready",
        "local_generated",
        "ops_schema_valid",
        "ops_semantic_valid",
        "preview_ready",
        "approved",
        "applied",
        "validation_passed",
        "validation_failed",
        "repair_generated",
        "restored",
        "recorded"
      ]
    },
    "retries_used": {
      "type": "integer",
      "description": "Number of JSON retries used.",
      "minimum": 0
    },
    "created_at": {
      "type": "string",
      "description": "ISO 8601 timestamp of run creation.",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "description": "ISO 8601 timestamp of last update.",
      "format": "date-time"
    },
    "artifacts_dir": {
      "type": "string",
      "description": "Path to the run artifacts directory."
    }
  },
  "additionalProperties": false
}
